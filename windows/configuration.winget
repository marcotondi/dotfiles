# Dotfiles Windows Configuration
# Apply with: winget configure -f configuration.winget --accept-configuration-agreements --disable-interactivity
# Or run through init.ps1 for the full dotfiles bootstrap.

$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:

# =============================================================================
# Developer Mode
# =============================================================================
- type: Microsoft.Windows/Registry
  name: DeveloperMode
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock
    valueName: AllowDevelopmentWithoutDevLicense
    valueData:
      DWord: 1
  metadata:
    description: Enable Developer Mode
    securityContext: elevated

# =============================================================================
# Long path support
# =============================================================================
- type: Microsoft.Windows/Registry
  name: LongPaths
  properties:
    keyPath: HKLM\SYSTEM\CurrentControlSet\Control\FileSystem
    valueName: LongPathsEnabled
    valueData:
      DWord: 1
  metadata:
    description: Enable Win32 long path support
    securityContext: elevated

# =============================================================================
# Dark Theme
# =============================================================================
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: DarkTheme
  properties:
    getScript: |
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'
      $apps   = Get-ItemPropertyValue $regPath -Name AppsUseLightTheme -EA SilentlyContinue
      $system = Get-ItemPropertyValue $regPath -Name SystemUsesLightTheme -EA SilentlyContinue
      return @{ AppsUseLightTheme = [int]$apps; SystemUsesLightTheme = [int]$system }
    testScript: |
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'
      $apps   = Get-ItemPropertyValue $regPath -Name AppsUseLightTheme -EA SilentlyContinue
      $system = Get-ItemPropertyValue $regPath -Name SystemUsesLightTheme -EA SilentlyContinue
      return ($apps -eq 0 -and $system -eq 0)
    setScript: |
      $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Themes\Personalize'
      Set-ItemProperty -Path $regPath -Name AppsUseLightTheme -Value 0
      Set-ItemProperty -Path $regPath -Name SystemUsesLightTheme -Value 0
  metadata:
    description: Set dark theme

# =============================================================================
# Sudo (inline mode)
# =============================================================================
- type: Microsoft.Windows/Registry
  name: Sudo
  properties:
    keyPath: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo
    valueName: Enabled
    valueData:
      DWord: 3
  metadata:
    description: Enable Sudo in inline mode
    securityContext: elevated

# =============================================================================
# File Explorer
# =============================================================================
- type: Microsoft.Windows/Registry
  name: ShowFileExtensions
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: HideFileExt
    valueData:
      DWord: 0
  metadata:
    description: Show file extensions
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: ShowHiddenFiles
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Hidden
    valueData:
      DWord: 1
  metadata:
    description: Show hidden files
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: OpenThisPC
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: LaunchTo
    valueData:
      DWord: 1
  metadata:
    description: Open File Explorer to This PC
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: FullPathTitlebar
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: FullPathAddress
    valueData:
      DWord: 1
  metadata:
    description: Show full path in titlebar
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: FrequentFolders
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: ShowFrequent
    valueData:
      DWord: 0
  metadata:
    description: Disable frequent folders in Quick Access
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: RecentFiles
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer
    valueName: ShowRecent
    valueData:
      DWord: 0
  metadata:
    description: Disable recent files in Quick Access
    securityContext: elevated

# =============================================================================
# Taskbar
# =============================================================================
- type: Microsoft.Windows/Registry
  name: HideWidgets
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarDa
    valueData:
      DWord: 0
  metadata:
    description: Hide Widgets button
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: EndTask
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: TaskbarEndTask
    valueData:
      DWord: 1
  metadata:
    description: Enable End Task on right-click
    securityContext: elevated

# =============================================================================
# Start & Search
# =============================================================================
- type: Microsoft.Windows/Registry
  name: WebSearchOff
  properties:
    keyPath: HKCU\SOFTWARE\Policies\Microsoft\Windows\Explorer
    valueName: DisableSearchBoxSuggestions
    valueData:
      DWord: 1
  metadata:
    description: Disable web search in Start
    securityContext: elevated

- type: Microsoft.Windows/Registry
  name: StartRecommendations
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Advanced
    valueName: Start_IrisRecommendations
    valueData:
      DWord: 0
  metadata:
    description: Disable Start recommendations
    securityContext: elevated

# =============================================================================
# Notifications
# =============================================================================
- type: Microsoft.Windows/Registry
  name: DoNotDisturb
  properties:
    keyPath: HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Notifications\Settings
    valueName: NOC_GLOBAL_SETTING_TOASTS_ENABLED
    valueData:
      DWord: 0
  metadata:
    description: Enable Do Not Disturb
    securityContext: elevated

# =============================================================================
# PowerShell 7 + Windows Terminal
# =============================================================================
- type: Microsoft.WinGet/Package
  name: PowerShell
  properties:
    id: Microsoft.PowerShell
    source: winget
    useLatest: true
    installMode: silent
  metadata:
    description: Install PowerShell 7

- type: Microsoft.WinGet/Package
  name: Terminal
  properties:
    id: Microsoft.WindowsTerminal
    source: winget
    useLatest: true
    installMode: silent
  metadata:
    description: Install Windows Terminal

- type: Microsoft.DSC.Transitional/PowerShellScript
  name: Ps7DefaultProfile
  dependsOn:
    - PowerShell
    - Terminal
  properties:
    getScript: |
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { return @{ defaultProfile = $null } }
      $raw = Get-Content $settingsPath -Raw -EA SilentlyContinue
      if (-not $raw) { return @{ defaultProfile = $null } }
      $json = $raw | ConvertFrom-Json -EA SilentlyContinue
      $ps7 = $json.profiles.list | Where-Object { $_.source -eq 'Windows.Terminal.PowershellCore' } | Select-Object -First 1
      return @{ defaultProfile = $json.defaultProfile; ps7Guid = $ps7.guid }
    testScript: |
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { return $true }
      $raw = Get-Content $settingsPath -Raw -EA SilentlyContinue
      if (-not $raw) { return $true }
      $json = $raw | ConvertFrom-Json -EA SilentlyContinue
      $ps7 = $json.profiles.list | Where-Object { $_.source -eq 'Windows.Terminal.PowershellCore' } | Select-Object -First 1
      return ($ps7 -and $json.defaultProfile -eq $ps7.guid)
    setScript: |
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { return }
      $raw = Get-Content $settingsPath -Raw -Encoding utf8
      $json = $raw | ConvertFrom-Json
      $ps7 = $json.profiles.list | Where-Object { $_.source -eq 'Windows.Terminal.PowershellCore' } | Select-Object -First 1
      if ($ps7 -and $json.defaultProfile -ne $ps7.guid) {
        $json.defaultProfile = $ps7.guid
        $json | ConvertTo-Json -Depth 32 | Set-Content $settingsPath -Encoding utf8
      }
  metadata:
    description: Set PowerShell 7 as default Terminal profile

# =============================================================================
# Cascadia Code Nerd Font
# =============================================================================
- type: Microsoft.DSC.Transitional/PowerShellScript
  name: InstallCascadiaCodeNF
  dependsOn:
    - PowerShell
  properties:
    getScript: |
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wanted = @('CascadiaCodeNF.ttf', 'CascadiaMonoNF.ttf')
      $present = $wanted | ForEach-Object { Test-Path (Join-Path $fontsDir $_) }
      return @{ installed = ($present -notcontains $false) }
    testScript: |
      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $wanted = @('CascadiaCodeNF.ttf', 'CascadiaMonoNF.ttf')
      $present = $wanted | ForEach-Object { Test-Path (Join-Path $fontsDir $_) }
      return ($present -notcontains $false)
    setScript: |
      $version  = '2407.24'
      $wanted   = @('CascadiaCodeNF.ttf', 'CascadiaMonoNF.ttf')
      $zipUrl   = "https://github.com/microsoft/cascadia-code/releases/download/v$version/CascadiaCode-$version.zip"
      $workDir  = Join-Path $env:TEMP "CascadiaCode-$version"
      $zipPath  = Join-Path $workDir 'CascadiaCode.zip'
      $null = New-Item -ItemType Directory -Path $workDir -Force

      $fontsDir = Join-Path $env:LOCALAPPDATA 'Microsoft\Windows\Fonts'
      $null = New-Item -ItemType Directory -Path $fontsDir -Force

      Write-Host "Downloading Cascadia Code NF $version ..."
      $ProgressPreference = 'SilentlyContinue'
      Invoke-WebRequest -Uri $zipUrl -OutFile $zipPath -UseBasicParsing

      Add-Type -AssemblyName System.IO.Compression.FileSystem
      Add-Type -AssemblyName System.Drawing
      $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath)

      try {
        foreach ($name in $wanted) {
          $entry = $zip.Entries | Where-Object { $_.Name -eq $name } | Select-Object -First 1
          if (-not $entry) { Write-Warning "Not found in archive: $name"; continue }
          $dest = Join-Path $fontsDir $name
          Write-Host "  Installing $name"
          [System.IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $dest, $true)
          $pfc = New-Object System.Drawing.Text.PrivateFontCollection
          try { $pfc.AddFontFile($dest); $family = $pfc.Families[0].Name }
          finally { $pfc.Dispose() }
          $regPath = 'HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts'
          New-ItemProperty -Path $regPath -Name "$family (TrueType)" -Value $dest -PropertyType String -Force | Out-Null
        }
      }
      finally { $zip.Dispose() }
      Remove-Item $zipPath -Force
      Write-Host "Done. Restart terminal to pick up the new fonts."
  metadata:
    description: Install Cascadia Code Nerd Fonts

- type: Microsoft.DSC.Transitional/PowerShellScript
  name: SetCascadiaMonoNF
  dependsOn:
    - Terminal
    - InstallCascadiaCodeNF
  properties:
    getScript: |
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { return @{ fontFace = $null } }
      $raw = Get-Content $settingsPath -Raw -EA SilentlyContinue
      if (-not $raw) { return @{ fontFace = $null } }
      $json = $raw | ConvertFrom-Json -EA SilentlyContinue
      return @{ fontFace = $json.profiles.defaults.font.face }
    testScript: |
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { return $true }
      $raw = Get-Content $settingsPath -Raw -EA SilentlyContinue
      if (-not $raw) { return $true }
      $json = $raw | ConvertFrom-Json -EA SilentlyContinue
      return ($json.profiles.defaults.font.face -eq 'Cascadia Mono NF')
    setScript: |
      $fontFace = 'Cascadia Mono NF'
      $settingsPath = @(
          "$env:LOCALAPPDATA\Packages\Microsoft.WindowsTerminal_*\LocalState\settings.json"
          "$env:LOCALAPPDATA\Microsoft\Windows Terminal\settings.json"
      ) | Where-Object { Test-Path $_ } | Select-Object -First 1
      if (-not $settingsPath) { throw 'Terminal settings.json not found.' }
      $raw = Get-Content $settingsPath -Raw -Encoding utf8
      $json = $raw | ConvertFrom-Json -AsHashtable
      if (-not $json.profiles)               { $json.profiles = [ordered]@{} }
      if (-not $json.profiles.defaults)      { $json.profiles.defaults = [ordered]@{} }
      if (-not $json.profiles.defaults.font) { $json.profiles.defaults.font = [ordered]@{} }
      $json.profiles.defaults.font.face = $fontFace
      $json | ConvertTo-Json -Depth 32 | Set-Content $settingsPath -Encoding utf8
      Write-Host "Set Terminal default font to $fontFace"
  metadata:
    description: Set Cascadia Mono NF as default Terminal font

